# ===== API 环境变量 =====

# API 统一前缀（网关路由前缀，与后端保持一致）
VITE_API_BASE_URL=/v1

# 后端服务地址（Vite 开发代理目标）
# 本地联调请指向本机服务，如：http://localhost:1114
# 生产/其他环境可通过 .env.local 覆盖该值
VITE_API_PROXY_TARGET=http://localhost:1114

# RustFS 文件下载直链网关（Vite 开发代理目标）
# 下载直链为统一网关下的 /v1/io 路径，代理转发后同源下载，避免浏览器跨域
# 页面与网关同源部署时（均 xyhraics.top）无需直连，此值仅用于开发代理
VITE_RUSTFS_GATEWAY=http://xyhraics.top
